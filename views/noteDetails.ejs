<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>File: <%= filename%></title>
  <link rel="stylesheet" href="../stylesheet/noteDetails.css">
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="card-header">
        <h2><%=filename.replace('.txt','')%></h2>
      </div>
      <div class="card-body">
        <p><%=data%></p>
      </div>
    </div>
  </div>
</body>
</html>